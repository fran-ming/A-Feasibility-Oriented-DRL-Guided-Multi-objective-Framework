<?xml version="1.0" encoding="utf-8"?>
<!-- Scenario of the demonstration run (one VUT + four OTs).
     Run   sumo-gui -c scenario_replay.sumocfg   and press the green play button.

     The vehicles are driven by SUMO's FCD replay device from output/replay.fcd.xml,
     which is generated by retime.py (or build_fcd.py). The VUT speed control and the
     release of every OT at its trigger crossing are already contained in that file, so
     a plain SUMO run reproduces them; no TraCI script is needed to replay the scenario.

     network/map.net.xml is NOT part of the repository.
     Supply your own network, see the README. -->
<configuration>
  <input>
    <net-file value="network/map.net.xml"/>
    <additional-files value="types.add.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="133.4"/>
    <step-length value="0.2"/>
  </time>
  <fcd_replay_device>
    <device.fcd-replay.probability value="1"/>
    <device.fcd-replay.files value="output/replay.fcd.xml"/>
  </fcd_replay_device>
  <processing>
    <time-to-teleport value="-1"/>
    <collision.action value="none"/>
  </processing>
  <report>
    <no-step-log value="true"/>
    <no-warnings value="true"/>
    <duration-log.disable value="true"/>
  </report>
</configuration>
